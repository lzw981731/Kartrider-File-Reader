    <None Remove="Controls\DarkTreeView\Icons\object_unknown.png" />
    <None Remove="Controls\DarkTreeView\Icons\relement_base.png" />
    <None Remove="Controls\DarkTreeView\Icons\relement_recamera.png" />
    <None Remove="Resources\baseline_arrow_left_black_18dp.png" />
    <None Remove="Resources\baseline_folder_black_18dp.png" />
    <None Remove="Resources\baseline_insert_drive_file_black_18dp.png" />
    <None Remove="Resources\ic_fluent_arrow_hook_up_left_24_filled.png" />
